# Start daemon
on boot
    start vendor.qwesd

# Used 'disabled' flag, so daemon won't be started until explicit start
service vendor.qwesd /vendor/bin/qwesd
    class late_start
    user root
    group root inet
    disabled
    seclabel u:r:recovery:s0
